#include <WiFi.h>
#include <HTTPClient.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <DHT.h>
#include <OneWire.h>
#include <DallasTemperature.h>

// ================= WIFI =================
const char* WIFI_SSID = "Wokwi-GUEST"; 
const char* WIFI_PASS = "";

// ============== THINGSPEAK ==============
// ============== THINGSPEAK ==============
const char* THINGSPEAK_API_KEY = "M1M37OJGI3V6PX30";
const unsigned long THINGSPEAK_CHANNEL_ID = 3482867;
// ================ PINS ==================
#define PIN_DHT           16
#define DHTTYPE          DHT22

#define PIN_SOIL_MOISTURE 34
#define PIN_ONE_WIRE_BUS  4

#define PIN_RELAY_PUMP    26
#define PIN_RELAY_VENT    27

// ============== THRESHOLDS ==============
const float SOIL_DRY_THRESHOLD = 30.0;
const float AIR_TEMP_HIGH      = 32.0;
const float HUMIDITY_HIGH      = 85.0;

// Soil sensor calibration
const int ADC_DRY = 3200;
const int ADC_WET = 1500;

// ============== OBJECTS =================
DHT dht(PIN_DHT, DHTTYPE);

LiquidCrystal_I2C lcd(0x27, 20, 4);

OneWire oneWire(PIN_ONE_WIRE_BUS);
DallasTemperature soilTempSensor(&oneWire);

// ============== TIMER ===================
unsigned long lastUploadTime = 0;

// ThingSpeak requires at least 15 sec
const unsigned long UPLOAD_INTERVAL = 20000;


// ========================================
// WiFi Connection
// ========================================
void connectWiFi() {

  if (WiFi.status() == WL_CONNECTED) {
    return;
  }

  Serial.print("Connecting WiFi");

  WiFi.begin(WIFI_SSID, WIFI_PASS, 6);

  int count = 0;

  while (WiFi.status() != WL_CONNECTED && count < 20) {

    delay(500);
    Serial.print(".");

    count++;
  }

  if (WiFi.status() == WL_CONNECTED) {

    Serial.println();
    Serial.println("WiFi Connected!");

    Serial.print("IP Address: ");
    Serial.println(WiFi.localIP());

  } else {

    Serial.println();
    Serial.println("WiFi Connection Failed!");
  }
}


// ========================================
// Read Soil Moisture
// ========================================
float readSoilMoisture() {

  int rawValue = analogRead(PIN_SOIL_MOISTURE);

  float moisture =
      (float)(ADC_DRY - rawValue) * 100.0 /
      (ADC_DRY - ADC_WET);

  moisture = constrain(moisture, 0.0, 100.0);

  Serial.print("Soil Raw: ");
  Serial.print(rawValue);

  Serial.print("  Moisture: ");
  Serial.print(moisture);

  Serial.println("%");

  return moisture;
}


// ========================================
// Send Data to ThingSpeak
// ========================================
void uploadToThingSpeak(
  float soilMoisture,
  float soilTemp,
  float airTemp,
  float humidity,
  bool pumpState,
  bool fanState
) {

  if (WiFi.status() != WL_CONNECTED) {

    Serial.println("WiFi not connected.");
    return;
  }

  HTTPClient http;

String url =
  "http://api.thingspeak.com/update?api_key=" +
  String(THINGSPEAK_API_KEY) +
  "&field1=" + String(soilMoisture, 1) +
  "&field2=" + String(soilTemp, 1) +
  "&field3=" + String(airTemp, 1) +
  "&field4=" + String(humidity, 1) +
  "&field5=" + String(pumpState ? 1 : 0) +
  "&field6=" + String(fanState ? 1 : 0);

  Serial.println();
  Serial.println("Uploading to ThingSpeak...");

  http.begin(url);

  int responseCode = http.GET();

  if (responseCode > 0) {

    Serial.print("ThingSpeak Response: ");
    Serial.println(responseCode);

    String response = http.getString();

    Serial.print("Entry ID: ");
    Serial.println(response);

  } else {

    Serial.print("ThingSpeak Error: ");
    Serial.println(responseCode);
  }

  http.end();
}


// ========================================
// SETUP
// ========================================
void setup() {

  Serial.begin(115200);

  // Relay pins
  pinMode(PIN_RELAY_PUMP, OUTPUT);
  pinMode(PIN_RELAY_VENT, OUTPUT);

  // Relay OFF
  digitalWrite(PIN_RELAY_PUMP, HIGH);
  digitalWrite(PIN_RELAY_VENT, HIGH);

  // LCD
  lcd.init();
  lcd.backlight();

  lcd.setCursor(0, 0);
  lcd.print("IoT Green Roof");

  lcd.setCursor(0, 1);
  lcd.print("Monitoring System");

  lcd.setCursor(0, 2);
  lcd.print("Initializing...");

  // Sensors
  dht.begin();
  soilTempSensor.begin();

  // WiFi
  WiFi.mode(WIFI_STA);

  connectWiFi();

  delay(2000);

  lcd.clear();
}


// ========================================
// LOOP
// ========================================
void loop() {

  connectWiFi();

  // -------- Read DHT22 --------
  float airTemp = dht.readTemperature();
  float humidity = dht.readHumidity();

  // -------- Read Soil Temperature --------
  soilTempSensor.requestTemperatures();

  float soilTemp =
      soilTempSensor.getTempCByIndex(0);

  // -------- Read Soil Moisture --------
  float soilMoisture =
      readSoilMoisture();


  // DHT error check
  if (isnan(airTemp) || isnan(humidity)) {

    Serial.println("DHT22 reading error!");

    airTemp = 0;
    humidity = 0;
  }


  // ======================================
  // PUMP CONTROL
  // ======================================

  bool pumpState = false;

  if (soilMoisture < SOIL_DRY_THRESHOLD) {

    digitalWrite(PIN_RELAY_PUMP, LOW);

    pumpState = true;

  } else {

    digitalWrite(PIN_RELAY_PUMP, HIGH);

    pumpState = false;
  }


  // ======================================
  // FAN CONTROL
  // ======================================

  bool fanState = false;

  if (airTemp > AIR_TEMP_HIGH ||
      humidity > HUMIDITY_HIGH) {

    digitalWrite(PIN_RELAY_VENT, LOW);

    fanState = true;

  } else {

    digitalWrite(PIN_RELAY_VENT, HIGH);

    fanState = false;
  }


  // ======================================
  // SERIAL MONITOR
  // ======================================

  Serial.println();
  Serial.println("===== GREEN ROOF STATUS =====");

  Serial.print("Air Temperature : ");
  Serial.print(airTemp);
  Serial.println(" C");

  Serial.print("Humidity        : ");
  Serial.print(humidity);
  Serial.println(" %");

  Serial.print("Soil Temperature: ");
  Serial.print(soilTemp);
  Serial.println(" C");

  Serial.print("Soil Moisture   : ");
  Serial.print(soilMoisture);
  Serial.println(" %");

  Serial.print("Pump            : ");
  Serial.println(pumpState ? "ON" : "OFF");

  Serial.print("Ventilation Fan : ");
  Serial.println(fanState ? "ON" : "OFF");


  // ======================================
  // LCD DISPLAY
  // ======================================

  lcd.setCursor(0, 0);
  lcd.print("Air:");
  lcd.print(airTemp, 1);
  lcd.print((char)223);
  lcd.print("C ");

  lcd.print("H:");
  lcd.print(humidity, 0);
  lcd.print("%   ");


  lcd.setCursor(0, 1);
  lcd.print("Soil:");
  lcd.print(soilTemp, 1);
  lcd.print((char)223);
  lcd.print("C ");

  lcd.print("M:");
  lcd.print(soilMoisture, 0);
  lcd.print("%   ");


  lcd.setCursor(0, 2);
  lcd.print("Pump:");
  lcd.print(pumpState ? "ON " : "OFF");

  lcd.print(" Fan:");
  lcd.print(fanState ? "ON " : "OFF");


  lcd.setCursor(0, 3);

  if (pumpState || fanState) {

    lcd.print("Status: ALERT      ");

  } else {

    lcd.print("Status: OPTIMAL    ");
  }


  // ======================================
  // THINGSPEAK UPLOAD
  // ======================================

  if (millis() - lastUploadTime >=
      UPLOAD_INTERVAL) {

    lastUploadTime = millis();

    uploadToThingSpeak(
      soilMoisture,
      soilTemp,
      airTemp,
      humidity,
      pumpState,
      fanState
    );
  }


  delay(2000);
}
